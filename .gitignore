# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local sqlite (dev only — production uses Turso)
local.db
local.db-journal
local.db-shm
local.db-wal

# vercel
.vercel

# claude code local settings (per-user)
.claude/

# opencode agent internals
.agents/
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

# dev artifacts
dev.log
dev.err.log
*.log
# AUDITORIA: estos tres patrones eran GLOBALES, asi que ignoraban
# cualquier imagen o HTML en CUALQUIER carpeta del repo. Por eso
# public/manifest.json solo tiene iconos SVG (Android e iOS quieren PNG)
# y por eso nunca se pudo commitear un opengraph-image.png. Anclados a la
# raiz siguen tapando las capturas sueltas sin bloquear public/.
/*.html
/*.jpeg
/*.png
/screenshots/
scripts/screenshots/

# playwright artifacts
/test-results/
/playwright-report/

# opencode
.opencode/

# Qdrant indexer cache (vocab + transient artifacts)
.qdrant-cache/
