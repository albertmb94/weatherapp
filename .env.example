TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# AEMET OpenData (Spain, all-country official network). Required for the
# `/api/aemet` endpoint; without it the Stations tab shows no AEMET stations.
# Free key: https://opendata.aemet.es/centrodedescargas/inicio
AEMET_API_KEY=

# Meteocat XEMA (Catalonia official network). Optional. Quotas are monthly,
# so the `/api/meteocat` route fetches the whole network once and caches
# it (~30 min CDN + 25 min per-instance memo). Without the key the Stations
# tab simply shows no Meteocat stations.
# Free key: https://apidocs.meteocat.gencat.cat/
METEOCAT_API_KEY=

# === Admin / Monetization ===
# Email del primer superadmin. Se añade automáticamente a la tabla admin_users
# en el primer arranque. Tras autenticarse por magic link puede invitar a otros
# admins desde /admin/users.
ADMIN_EMAIL=tu-email@dominio.com

# URL pública de la app (usada en magic links, webhooks Stripe, etc.)
APP_URL=https://weather.tudominio.com
NEXT_PUBLIC_APP_URL=https://weather.tudominio.com

# Resend — emails transaccionales (magic link admin, receipts). Opcional.
# Si está vacío, los magic links se imprimen por consola del servidor.
RESEND_API_KEY=

# Stripe — opcional. Si no se configura, /premium muestra UI pero el
# checkout no funcionará. Activar también feature.stripe en /admin/features.
# B-NBT-9c: los valores operativos (precios, price IDs, claves) se
# gestionan desde /admin/features (feature_flags.config); estas variables
# son placeholder para la futura integración directa.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Web Push — opcional (futuro). La configuración activa vive en
# feature_flags.config vía /admin/features; estas claves no se leen aún.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@tu-dominio.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Cron jobs (protegidos con bearer token). Generar con:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CRON_SECRET=

# Backtest semanal (/api/backtest). El endpoint responde 503 sin esta
# clave. Generar como CRON_SECRET.
BACKTEST_SECRET=

# Remitente de los emails transaccionales (usado por lib/emails.ts).
EMAIL_FROM="Weather <hola@tudominio.com>"

# Sentry — opcional (instrumentation.ts). Sin DSN no se inicializa.
SENTRY_DSN=
