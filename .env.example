TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# AEMET OpenData (Spain, all-country official network). Required for the
# `/api/aemet` endpoint; without it the Stations tab shows no AEMET stations.
# Free key: https://opendata.aemet.es/centrodedescargas/inicio
AEMET_API_KEY=

# Meteocat XEMA (Catalonia official network). Optional. Quotas are monthly,
# so the `/api/meteocat` route fetches the whole network once and caches
# it (~30 min CDN + 25 min per-instance memo). Without the key the Stations
# tab simply shows no Meteocat stations.
# Free key: https://apidocs.meteocat.gencat.cat/
METEOCAT_API_KEY=

# === Admin / Monetization ===
# Email del primer superadmin. Se añade automáticamente a la tabla admin_users
# en el primer arranque. Puede invitar a otros admins desde /admin/users.
ADMIN_EMAIL=tu-email@dominio.com

# Credenciales de acceso al panel (/admin/login). ADMIN_PASSWORD SOLO se usa
# para sembrar la fila inicial en admin_credentials (si la tabla está vacía);
# después rota desde /admin/settings. Si falta, no se siembra ningún acceso.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ADMIN_BYPASS_SECRET — ELIMINADO (auditoría S1, 2026-08-27).
# El bypass del owner emitía una cookie de admin válida 24h a quien
# hiciera POST con ADMIN_EMAIL a /api/admin/auth/request: sin contraseña,
# sin prueba de propiedad y sin fila en admin_sessions, por lo que ni el
# logout ni el cambio de contraseña podían revocarla. La ruta y el código
# de validación están borrados. BORRA esta variable de tu entorno de
# producción — ya no hace nada, pero no debe quedar circulando.
# El acceso al panel es usuario + contraseña en /admin/login.

# Secreto compartido entre el proxy Edge y /api/ingest. El proxy no puede
# mandar cookies en un fetch servidor-a-servidor, así que firma con esta
# cabecera para que la ingesta se fíe de las cabeceras de identidad.
# SIN ESTA VARIABLE no se registra el arranque de sesión (los pageviews
# por beacon del navegador sí siguen funcionando). Generar con:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
TRACK_INTERNAL_SECRET=

# URL pública canónica. lib/appUrl.ts la acepta como alternativa a
# NEXT_PUBLIC_APP_URL y no estaba documentada aquí.
APP_URL=

# URL pública de la app. Se usa para redirects de Stripe (success/cancel),
# enlaces de claim y emails (lib/appUrl.ts). Sin ella se usa el origin de la
# propia petición.
NEXT_PUBLIC_APP_URL=https://weather.tudominio.com

# Resend — emails transaccionales (claim premium, newsletter confirm, admin).
# Opcional: si falta, la feature feature.resend debe tener api_key configurada
# en /admin/features para que se envíen emails.
RESEND_API_KEY=

# Stripe — los valores operativos (secret key, webhook secret, precios) se
# gestionan desde /admin/features (feature_flags.config) y /admin/plans.
# Estas variables quedan como referencia/futuro y NO se leen en runtime.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Web Push — opcional (futuro). La configuración activa vive en
# feature_flags.config vía /admin/features; estas claves no se leen aún.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@tu-dominio.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Cron jobs (protegidos con bearer token). Generar con:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CRON_SECRET=

# Backtest semanal (/api/backtest). El endpoint responde 503 sin esta
# clave. Generar como CRON_SECRET.
BACKTEST_SECRET=

# Solo para despliegues self-hosted sobre HTTP (sin TLS): permite que la
# cookie de sesión admin NO use Secure. En Vercel se omite.
DB_ALLOW_FILE_IN_PRODUCTION=

# Solo tooling de backtest (scripts/calibrateEnsemble.ts). Opcional; si
# falta usa file:local.db.
BACKTEST_DB_URL=

# ⚠️ NUNCA commitear credenciales reales aquí. Este fichero es solo una
# plantilla: los valores reales viven en .env.local (gitignored) y en
# las env vars de Vercel. Generar tokens en el dashboard de Turso.

# Remitente de los emails transaccionales (usado por lib/emails.ts).
EMAIL_FROM="Weather <hola@tudominio.com>"

# Sentry — opcional (instrumentation.ts). Sin DSN no se inicializa.
SENTRY_DSN=
